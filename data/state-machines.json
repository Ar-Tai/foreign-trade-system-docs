        "approved",
        "sent",
        "accepted",
        "expired",
        "withdrawn"
      ],
      "transitions": [
        [
          "draft",
          "submit",
          "pending_approval",
          "complete_fields_and_price_policy"
        ],
        [
          "pending_approval",
          "approve",
          "approved",
          "independent_authorized_approver"
        ],
        [
          "pending_approval",
          "reject",
          "draft",
          "review_reason"
        ],
        [
          "approved",
          "issue",
          "sent",
          "approved_revision_and_safe_attachment"
        ],
        [
          "sent",
          "accept",
          "accepted",
          "authorized_customer_and_before_expiry"
        ],
        [
          "sent",
          "expire",
          "expired",
          "server_time_after_validity"
        ],
        [
          "sent",
          "withdraw",
          "withdrawn",
          "not_already_accepted"
        ]
      ]
