{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250
    },
    "source_date": {
      "type": "string",
      "format": "date"
    },
    "kind": {
      "const": "business_taxonomy_not_customs_codes"
    },
    "counts": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "integer",
          "minimum": 1
        },
        "secondary": {
          "type": "integer",
          "minimum": 1
        },
        "example_mentions": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "primary",
        "secondary",
        "example_mentions"
      ],
      "additionalProperties": false
    },
    "examples_are_unique": {
      "const": false
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "business_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 250
            },
            "minItems": 1
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "children": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9]{2}\\.[0-9]{2}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 250
                },
                "examples": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 250
                  },
                  "minItems": 1
                }
              },
              "required": [
                "id",
                "name",
                "examples"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "name",
          "business_modes",
          "note",
          "children"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "version",
    "source_date",
    "kind",
    "counts",
    "examples_are_unique",
    "categories"
  ],
  "additionalProperties": false
}
